NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL di destinazione del QR code "Iscriviti alla newsletter" nel PDF
# menu. Se non impostata, viene usato https://vizio-fiumicino.it come
# segnaposto temporaneo (vedi app/api/pdf/menu/route.ts).
NEWSLETTER_SIGNUP_URL=

# URL pubblico del sito, usato per i link canonical e per gli URL
# assoluti delle immagini Open Graph (le anteprime social non
# accettano percorsi relativi).
#
# Va impostata PER AMBIENTE su Vercel:
#   Production → https://vizio-fiumicino.it
#   Preview    → lasciare vuota: si ricade su VERCEL_URL, l'indirizzo
#                del deploy corrente
#
# Motivo: fino al cutover DNS il dominio finale serve ancora il vecchio
# sito WordPress. Puntandoci sopra in anteprima, le immagini social non
# risolverebbero e le condivisioni risulterebbero rotte.
NEXT_PUBLIC_SITE_URL=

# Chiave API di Resend, per le email di conferma prenotazione (al
# cliente) e di notifica (allo staff) — §21 passo 3. Senza questa
# variabile l'invio viene saltato e l'errore loggato: la prenotazione
# resta comunque valida, l'email non è mai una condizione per la sua
# creazione (vedi src/lib/prenotazioni/email.ts).
#
# Il mittente (prenotazioni@vizio-fiumicino.it) non è una variabile:
# per funzionare deve essere su un dominio verificato nel pannello
# Resend, un passaggio da fare lì, non qui.
RESEND_API_KEY=
