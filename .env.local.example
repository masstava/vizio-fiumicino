# =============================================================
# Variabili d'ambiente — elenco ricavato dal codice
# =============================================================
# "Pubblica" = NEXT_PUBLIC_*: il valore finisce nel JavaScript inviato
# al browser ed è fissato al momento della BUILD. Le altre restano sul
# server. Su Vercel ogni modifica vale solo dal deploy successivo.

# --- Supabase (obbligatorie, pubbliche) ----------------------------
# URL del progetto e chiave pubblicabile. Senza, il sito non legge
# nulla dal database e la dashboard non autentica. L'URL serve anche
# a costruire l'indirizzo del video della home (Supabase Storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Dominio del sito e indicizzazione (facoltativa, server) -------
# URL pubblico del sito. È anche L'INTERRUTTORE DELL'INDICIZZAZIONE
# (src/lib/indicizzazione.ts): il sito è indicizzabile solo se vale
# esattamente https://vizio-fiumicino.it e il deploy non è una
# preview. In ogni altro caso tutto resta noindex.
#
# Fino al cutover DNS: NON impostarla (il dominio serve ancora il
# vecchio WordPress). Il giorno del cutover: impostarla in Production
# su https://vizio-fiumicino.it e rifare il deploy — è l'unico gesto.
#
# Se manca, l'URL del sito ricade, in produzione, sul dominio di
# produzione del progetto (VERCEL_PROJECT_PRODUCTION_URL, stabile); in
# preview su VERCEL_URL (l'indirizzo del deploy corrente); in locale su
# http://localhost:3000. Si usa per canonical,
# immagini Open Graph, link nelle email (gestione prenotazione,
# disiscrizione newsletter, "prenota di nuovo").
SITE_URL=

# Alternativa storica a SITE_URL, letta solo se SITE_URL manca.
# Lasciarla VUOTA: è pubblica (fissata alla build) e NON accende
# l'indicizzazione; impostarla prima del cutover farebbe puntare
# canonical e link delle email al vecchio sito.
NEXT_PUBLIC_SITE_URL=

# --- Email (facoltativa, server) ------------------------------------
# Chiave API di Resend, per le email di conferma/cancellazione
# prenotazione (al cliente), di notifica (allo staff) e di benvenuto
# della newsletter. Senza, l'invio viene saltato e l'errore loggato:
# prenotazioni e iscrizioni restano comunque valide.
RESEND_API_KEY=

# Mittente di tutte le email (facoltativa, server): "Nome <indirizzo>"
# oppure solo l'indirizzo. Deve stare su un dominio verificato nel
# pannello Resend. Se manca o è malformata:
#   Vizio Bistrot <prenotazioni@vizio-fiumicino.it>
EMAIL_MITTENTE=

# Destinatari delle notifiche staff su nuove prenotazioni e
# cancellazioni (facoltativa, server): indirizzi separati da virgola.
# Quelli malformati vengono ignorati (e segnalati nei log); se non ne
# resta nessuno, o la variabile manca:
#   info@vizio-fiumicino.it, m.tavaroli@easydigitalgroup.it
EMAIL_DESTINATARI_STAFF=

# Reply-To delle email al CLIENTE: conferma e cancellazione della
# prenotazione, benvenuto della newsletter (facoltativa, server).
# "Nome <indirizzo>" oppure solo l'indirizzo. Se manca o è malformata:
#   info@vizio-fiumicino.it
# La notifica allo staff ha invece come Reply-To l'email del cliente,
# se ne ha lasciata una valida: non si configura.
EMAIL_REPLY_TO=

# --- PDF del menu (facoltativa, server) -----------------------------
# Destinazione del QR "Iscriviti alla newsletter" nel PDF del menu.
# Se manca: https://vizio-fiumicino.it — che fino al cutover è il
# vecchio WordPress (vedi app/api/pdf/menu/route.ts).
NEWSLETTER_SIGNUP_URL=

# --- Impostate da Vercel, NON da definire a mano --------------------
# VERCEL_PROJECT_PRODUCTION_URL — dominio di produzione del progetto:
#               ricaduta di SITE_URL in produzione. Vercel ci mette il
#               dominio personalizzato più corto, se ce n'è uno: se
#               vizio-fiumicino.it viene aggiunto al progetto prima del
#               cambio DNS, i link nelle email puntano al vecchio sito.
# VERCEL_URL  — indirizzo del deploy corrente (ricaduta in preview)
# VERCEL_ENV  — production / preview / development: una preview non
#               diventa mai indicizzabile, qualunque sia SITE_URL
